# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML 에셋은 텍스트로 취급 (머지 충돌 확인 용이)
*.meta text
*.unity text
*.asset text
*.prefab text
*.mat text
*.anim text
*.controller text
*.physicMaterial text
*.physicsMaterial2D text

# 바이너리 파일
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.a binary
